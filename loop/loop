#!/usr/bin/env bash
#
# Launcher for the loop stress harness of the Elixir binding: starts
# the emulator on the compiled binding and the compiled utility and
# hands it every argument unchanged. build.sh compiles both; this
# script builds nothing.
#
# The emulator is started with the break handler off and the utility
# is run in the background rather than exec'd, so that an interrupt
# can be translated here into the termination signal the utility does
# receive: the emulator owns SIGINT below the signal server and never
# lets BEAM code see it, while SIGTERM reaches the utility's own
# handler and starts its graceful stop. The child's exit status is
# passed through unchanged.
#
# Usage:
#   ./loop/loop --duration 2m --shape both

set -eu
set -o pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
BUILD="$HERE/../_build/dev/lib"

for ebin in "$BUILD/libitb3/ebin" "$BUILD/libitb3_elixir/ebin"; do
    if [ ! -d "$ebin" ]; then
        echo "loop: binding not compiled, run ./build.sh first: $ebin" >&2
        exit 1
    fi
done
if [ ! -f "$HERE/Elixir.Loop.Main.beam" ]; then
    echo "loop: utility not compiled, run ./build.sh first: $HERE" >&2
    exit 1
fi

# `elixir` already runs the emulator without a shell, so the utility
# owns every byte the process prints; +Bi leaves the interrupt to the
# trap below. Everything after -- reaches the utility as System.argv().
elixir --erl "+Bi -boot no_dot_erlang" \
       -pa "$BUILD/libitb3/ebin" -pa "$BUILD/libitb3_elixir/ebin" -pa "$HERE" \
       -e 'Loop.Main.start()' -- "$@" &
child=$!

trap 'kill -TERM "$child" 2>/dev/null || true' INT TERM

set +e
wait "$child"
rc=$?
# A trapped signal makes the first wait return 128 + signal number
# rather than the child's status; waiting again yields the status the
# child actually exited with.
if [ "$rc" -gt 128 ]; then
    wait "$child"
    rc=$?
fi
exit "$rc"
